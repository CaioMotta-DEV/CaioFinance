@page "/"
@model CaioFinance.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-head">
    <p class="eyebrow">Dashboard</p>
    <div class="month-nav">
        <a class="icon-link" asp-page="/Dashboard/Index" asp-route-ano="@Model.MesAnterior.Year" asp-route-mes="@Model.MesAnterior.Month" aria-label="Mês anterior">‹</a>
        <h1>@Model.TituloDoMes</h1>
        <a class="icon-link" asp-page="/Dashboard/Index" asp-route-ano="@Model.ProximoMes.Year" asp-route-mes="@Model.ProximoMes.Month" aria-label="Próximo mês">›</a>
    </div>
</section>

<section class="metrics" aria-label="Resumo">
    <article class="metric metric-balance">
        <span>Saldo total</span>
        <strong>@Model.SaldoTotal.ToString("C")</strong>
        <small>Soma das contas conectadas</small>
    </article>
    <article class="metric">
        <span>Gastos do mês</span>
        <strong class="neg">@Math.Abs(Model.GastosDoMes).ToString("C")</strong>
        <small>Saídas do extrato</small>
    </article>
    <article class="metric">
        <span>Entradas do mês</span>
        <strong class="pos">@Model.EntradasDoMes.ToString("C")</strong>
        <small>Entradas do extrato</small>
    </article>
</section>

<div class="split dashboard-split">
    <section class="panel chart-panel" aria-labelledby="grafico-titulo">
        <div class="panel-head">
            <h2 id="grafico-titulo">Últimos 12 meses</h2>
            <span>Gastos e entradas</span>
        </div>
        <div class="chart-wrap">
            <canvas id="grafico-mensal" aria-label="Gráfico de gastos e entradas dos últimos 12 meses"></canvas>
        </div>
        <p class="chart-legend">
            <span class="legend-item gasto">Barras: gastos</span>
            <span class="legend-item entrada">Linha: entradas</span>
        </p>

        <div class="panel-head donut-head">
            <h2 id="rosca-titulo">Categorias do mês</h2>
            <span>Gastos</span>
        </div>
        <div class="chart-wrap chart-wrap-donut" id="rosca-wrap">
            <canvas id="grafico-categorias" aria-labelledby="rosca-titulo"></canvas>
        </div>
        <p id="rosca-vazio" class="empty" hidden>Nenhum gasto neste mês.</p>
    </section>

    <section class="panel extrato-panel" aria-labelledby="extrato-titulo">
        <div class="panel-head">
            <h2 id="extrato-titulo">Extrato</h2>
            <span>@Model.Extrato.Count lançamento@(Model.Extrato.Count == 1 ? "" : "s")</span>
        </div>
        @if (Model.Extrato.Count > 0)
        {
            <label class="extrato-busca">
                <span>Pesquisar no extrato</span>
                <input type="search" id="busca-extrato" placeholder="Nome, categoria ou banco" autocomplete="off" />
            </label>
            <p id="busca-vazia" class="empty" hidden>Nenhum lançamento encontrado.</p>
        }
        @if (Model.Extrato.Count == 0)
        {
            <p class="empty">Nenhum lançamento neste mês.</p>
        }
        else
        {
            <ul class="list statement-scroll">
                @foreach (var item in Model.Extrato)
                {
                    var tipo = item.dVlLancamento < 0 ? "gasto" : "entrada";
                    <li class="card statement-row">
                        <div class="statement-main">
                            <div class="card-top">
                                <time datetime="@item.tDtOcorrencia.ToString("yyyy-MM-dd")">@item.tDtOcorrencia.ToString("dd/MM/yyyy")</time>
                                <strong class="money @(item.dVlLancamento < 0 ? "neg" : "pos")">@item.dVlLancamento.ToString("C")</strong>
                            </div>
                            <h3 title="@item.sNmExibicao">@item.sNmExibicao</h3>
                            <p class="meta">
                                <span>@item.Categoria.sNmCategoria</span>
                                <span>@item.Conta.NomeExibicao</span>
                                @if (item.bFlContaFixa)
                                {
                                    <span class="badge">@Textos.ContaFixa</span>
                                }
                            </p>
                        </div>
                        <div class="icon-actions">
                            <button type="button"
                                    class="icon-button"
                                    data-editar
                                    data-id="@item.nCdLancamento"
                                    data-data="@item.tDtOcorrencia.ToString("yyyy-MM-dd")"
                                    data-nome="@item.sNmExibicao"
                                    data-original="@item.sNmOriginal"
                                    data-tipo="@tipo"
                                    data-valor="@Math.Abs(item.dVlLancamento).ToString("N2")"
                                    data-categoria="@item.nCdCategoria"
                                    data-conta="@item.nCdConta"
                                    aria-label="@Textos.Editar @item.sNmExibicao"
                                    title="@Textos.Editar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17.25V20h2.75L17.8 8.95l-2.75-2.75L4 17.25zm16.7-11.2a.75.75 0 0 0 0-1.06l-2.69-2.69a.75.75 0 0 0-1.06 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                            </button>
                            <button type="button"
                                    class="icon-button danger"
                                    data-excluir
                                    data-id="@item.nCdLancamento"
                                    data-nome="@item.sNmExibicao"
                                    data-fixa="@(item.bFlContaFixa ? "true" : "false")"
                                    aria-label="@Textos.Excluir @item.sNmExibicao"
                                    title="@Textos.Excluir">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12v2H6V7zm2 3h8l-.7 10.1a1 1 0 0 1-1 .9H9.7a1 1 0 0 1-1-.9L8 10zm3-6h2l1 1h4v2H6V5h4l1-1z"/></svg>
                            </button>
                            @if (item.dVlLancamento != 0 && item.bFlContaFixa)
                            {
                                <button type="button"
                                        class="icon-button is-fixed"
                                        data-desmarcar
                                        data-id="@item.nCdLancamento"
                                        data-nome="@item.sNmExibicao"
                                        aria-label="@Textos.DesmarcarContaFixa"
                                        title="@Textos.DesmarcarContaFixa">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 2H8v2H7v2h.2L6 12v2h5v7h2v-7h5v-2l-1.2-6H17V4h-1V2z"/><path d="M3.3 2.3 21.7 20.7l-1.4 1.4L1.9 3.7z"/></svg>
                                </button>
                            }
                            else if (item.dVlLancamento != 0)
                            {
                                <button type="button"
                                        class="icon-button"
                                        data-fixar
                                        data-id="@item.nCdLancamento"
                                        data-nome="@item.sNmExibicao"
                                        data-valor="@Math.Abs(item.dVlLancamento).ToString("N2")"
                                        aria-label="@Textos.MarcarContaFixa"
                                        title="@Textos.MarcarContaFixa">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 2H8v2H7v2h.2L6 12v2h5v7h2v-7h5v-2l-1.2-6H17V4h-1V2z"/></svg>
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<dialog id="janela-editar" class="janela">
    <form method="post" asp-page-handler="Salvar">
        <h2>Editar lançamento</h2>
        <input type="hidden" name="nCdLancamento" />
        <input type="hidden" name="ano" value="@Model.Ano" />
        <input type="hidden" name="mes" value="@Model.Mes" />
        <label>
            <span>Data</span>
            <input type="date" name="data" required />
        </label>
        <label>
            <span>Nome</span>
            <input name="sNmExibicao" maxlength="160" required autocomplete="off" />
        </label>
        <p class="original">@Textos.NomeNoBanco: <span data-original></span></p>
        <label>
            <span>Tipo</span>
            <select name="tipo">
                <option value="gasto">@Textos.Gasto</option>
                <option value="entrada">@Textos.Entrada</option>
            </select>
        </label>
        <label>
            <span>Valor</span>
            <input name="valor" inputmode="decimal" required autocomplete="off" />
        </label>
        <label>
            <span>Categoria</span>
            <select name="nCdCategoria">
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.nCdCategoria">@categoria.sNmCategoria</option>
                }
            </select>
        </label>
        <label>
            <span>Banco</span>
            <select name="nCdConta">
                @foreach (var conta in Model.Contas)
                {
                    <option value="@conta.nCdConta">@conta.NomeExibicao</option>
                }
            </select>
        </label>
        <div class="form-actions">
            <button type="submit">@Textos.Salvar</button>
            <button type="button" class="ghost" data-fechar>Cancelar</button>
        </div>
    </form>
</dialog>

<dialog id="janela-excluir" class="janela">
    <form method="post" asp-page-handler="Excluir">
        <h2>@Textos.Excluir lançamento</h2>
        <input type="hidden" name="nCdLancamento" />
        <input type="hidden" name="ano" value="@Model.Ano" />
        <input type="hidden" name="mes" value="@Model.Mes" />
        <p>Excluir <strong data-excluir-nome></strong> do extrato?</p>
        <p class="original" data-excluir-fixa hidden>Se for conta fixa, os lançamentos futuros dela também serão removidos.</p>
        <div class="form-actions">
            <button type="submit" class="danger">@Textos.Excluir</button>
            <button type="button" class="ghost" data-fechar>Cancelar</button>
        </div>
    </form>
</dialog>

<dialog id="janela-fixar" class="janela">
    <form method="post" asp-page-handler="MarcarContaFixa">
        <h2>@Textos.MarcarContaFixa</h2>
        <input type="hidden" name="nCdLancamento" />
        <input type="hidden" name="ano" value="@Model.Ano" />
        <input type="hidden" name="mes" value="@Model.Mes" />
        <p class="original">O apelido e o valor estimado entram nos lançamentos futuros, nas despesas ou nas receitas conforme este lançamento. O extrato deste mês não muda.</p>
        <label>
            <span>Apelido</span>
            <input name="apelido" maxlength="160" required autocomplete="off" />
        </label>
        <label>
            <span>Valor estimado</span>
            <input name="valorEstimado" inputmode="decimal" required autocomplete="off" />
        </label>
        <label>
            <span>Quantidade de meses</span>
            <input name="meses" type="number" min="1" max="60" value="24" required />
        </label>
        <label>
            <span>Começar em</span>
            <select name="inicio">
                <option value="proximo">Próximo mês</option>
                <option value="este">Este mês</option>
            </select>
        </label>
        <div class="form-actions">
            <button type="submit">@Textos.Salvar</button>
            <button type="button" class="ghost" data-fechar>Cancelar</button>
        </div>
    </form>
</dialog>

<dialog id="janela-desmarcar" class="janela">
    <form method="post" asp-page-handler="DesmarcarContaFixa">
        <h2>@Textos.DesmarcarContaFixa</h2>
        <input type="hidden" name="nCdLancamento" />
        <input type="hidden" name="ano" value="@Model.Ano" />
        <input type="hidden" name="mes" value="@Model.Mes" />
        <p>Desmarcar <strong data-desmarcar-nome></strong>? Os lançamentos futuros dessa conta fixa serão removidos. O lançamento continua no extrato.</p>
        <div class="form-actions">
            <button type="submit">@Textos.DesmarcarContaFixa</button>
            <button type="button" class="ghost" data-fechar>Cancelar</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        (() => {
            const dados = @Html.Raw(Model.GraficoJson);
            const canvas = document.getElementById("grafico-mensal");
            if (canvas && window.Chart) {
                new Chart(canvas, {
                    data: {
                        labels: dados.labels,
                        datasets: [
                            {
                                type: "bar",
                                label: "Gastos",
                                data: dados.gastos,
                                backgroundColor: "rgba(159, 18, 57, 0.65)",
                                borderRadius: 6,
                                order: 2
                            },
                            {
                                type: "line",
                                label: "Entradas",
                                data: dados.entradas,
                                borderColor: "#047857",
                                backgroundColor: "#047857",
                                tension: 0.25,
                                order: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: "index", intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label(contexto) {
                                        const valor = Number(contexto.parsed.y || 0);
                                        return `${contexto.dataset.label}: ${valor.toLocaleString("pt-BR", { style: "currency", currency: "BRL" })}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { autoSkip: false, maxRotation: 50, minRotation: 0, font: { size: 11 } }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback(valor) {
                                        return Number(valor).toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const categorias = Array.isArray(dados.categorias) ? dados.categorias : [];
            const rosca = document.getElementById("grafico-categorias");
            const roscaWrap = document.getElementById("rosca-wrap");
            const roscaVazio = document.getElementById("rosca-vazio");
            const paleta = ["#9f1239", "#0f766e", "#c2410c", "#1d4ed8", "#a16207", "#6d28d9", "#047857", "#be123c", "#0369a1", "#b45309", "#4338ca", "#3f6212"];
            if (categorias.length === 0) {
                if (roscaWrap) roscaWrap.hidden = true;
                if (roscaVazio) roscaVazio.hidden = false;
            } else if (rosca && window.Chart) {
                new Chart(rosca, {
                    type: "doughnut",
                    data: {
                        labels: categorias.map((item) => item.nome),
                        datasets: [{
                            data: categorias.map((item) => item.valor),
                            backgroundColor: categorias.map((_, indice) => paleta[indice % paleta.length]),
                            borderWidth: 2,
                            borderColor: "#ffffff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "62%",
                        plugins: {
                            legend: { position: "bottom", labels: { boxWidth: 12, padding: 12 } },
                            tooltip: {
                                callbacks: {
                                    label(contexto) {
                                        const valor = Number(contexto.parsed || 0);
                                        return `${contexto.label}: ${valor.toLocaleString("pt-BR", { style: "currency", currency: "BRL" })}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const preencher = (formulario, campos) => {
                Object.entries(campos).forEach(([nome, valor]) => {
                    const campo = formulario.elements.namedItem(nome);
                    if (campo) campo.value = valor ?? "";
                });
            };

            document.querySelectorAll("dialog.janela").forEach((janela) => {
                janela.addEventListener("cancel", (evento) => evento.preventDefault());
                janela.querySelectorAll("[data-fechar]").forEach((botao) => {
                    botao.addEventListener("click", () => janela.close());
                });
            });

            const janelaEditar = document.getElementById("janela-editar");
            document.querySelectorAll("[data-editar]").forEach((botao) => {
                botao.addEventListener("click", () => {
                    const formulario = janelaEditar.querySelector("form");
                    preencher(formulario, {
                        nCdLancamento: botao.dataset.id,
                        data: botao.dataset.data,
                        sNmExibicao: botao.dataset.nome,
                        tipo: botao.dataset.tipo,
                        valor: botao.dataset.valor,
                        nCdCategoria: botao.dataset.categoria,
                        nCdConta: botao.dataset.conta
                    });
                    const original = janelaEditar.querySelector("[data-original]");
                    if (original) original.textContent = botao.dataset.original || "";
                    janelaEditar.showModal();
                });
            });

            const janelaExcluir = document.getElementById("janela-excluir");
            document.querySelectorAll("[data-excluir]").forEach((botao) => {
                botao.addEventListener("click", () => {
                    const formulario = janelaExcluir.querySelector("form");
                    preencher(formulario, { nCdLancamento: botao.dataset.id });
                    const nome = janelaExcluir.querySelector("[data-excluir-nome]");
                    if (nome) nome.textContent = botao.dataset.nome || "";
                    const aviso = janelaExcluir.querySelector("[data-excluir-fixa]");
                    if (aviso) aviso.hidden = botao.dataset.fixa !== "true";
                    janelaExcluir.showModal();
                });
            });

            const janelaFixar = document.getElementById("janela-fixar");
            document.querySelectorAll("[data-fixar]").forEach((botao) => {
                botao.addEventListener("click", () => {
                    const formulario = janelaFixar.querySelector("form");
                    preencher(formulario, {
                        nCdLancamento: botao.dataset.id,
                        apelido: botao.dataset.nome,
                        valorEstimado: botao.dataset.valor,
                        meses: "24",
                        inicio: "proximo"
                    });
                    janelaFixar.showModal();
                });
            });

            const alinharExtrato = () => {
                const grafico = document.querySelector(".chart-panel");
                const extrato = document.querySelector(".extrato-panel");
                if (!grafico || !extrato) return;
                if (window.innerWidth <= 1100) {
                    extrato.style.height = "";
                    return;
                }
                extrato.style.height = `${grafico.offsetHeight}px`;
            };
            alinharExtrato();
            window.addEventListener("resize", alinharExtrato);

            const busca = document.getElementById("busca-extrato");
            const lista = document.querySelector(".statement-scroll");
            const buscaVazia = document.getElementById("busca-vazia");
            busca?.addEventListener("input", () => {
                const termo = busca.value.trim().toLocaleLowerCase("pt-BR");
                let visiveis = 0;
                lista?.querySelectorAll(".statement-row").forEach((linha) => {
                    const texto = linha.textContent.toLocaleLowerCase("pt-BR");
                    const mostra = termo.length === 0 || texto.includes(termo);
                    linha.hidden = !mostra;
                    if (mostra) visiveis++;
                });
                if (buscaVazia) buscaVazia.hidden = visiveis > 0;
            });

            const janelaDesmarcar = document.getElementById("janela-desmarcar");
            document.querySelectorAll("[data-desmarcar]").forEach((botao) => {
                botao.addEventListener("click", () => {
                    const formulario = janelaDesmarcar.querySelector("form");
                    preencher(formulario, { nCdLancamento: botao.dataset.id });
                    const nome = janelaDesmarcar.querySelector("[data-desmarcar-nome]");
                    if (nome) nome.textContent = botao.dataset.nome || "";
                    janelaDesmarcar.showModal();
                });
            });
        })();
    </script>
}
